generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  password          String
  firstName         String?
  lastName          String?
  gender            String?
  age               Int?
  location          String?
  phone             String?
  role              Role              @default(PATIENT)
  isBanned          Boolean           @default(false)
  isVerified        Boolean           @default(false)
  verificationCode  String?
  createdAt         DateTime          @default(now())
  passwordResetCode String?
  expoPushToken     String?
  passwordHistory   PasswordHistory[]
  doctor            Doctor?
  patient           Patient?
}

model Doctor {
  id                String         @id @default(uuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id])
  specialty         String?
  bio               String?
  clinicName        String?
  rating            Float          @default(0)
  isProfileComplete Boolean        @default(false)
  patients          Patient[]      @relation("PatientDoctor")
  cases             Case[]         @relation("DoctorCases")
  reports           Report[]       @relation("DoctorReports")
  consultations     Consultation[]
}

model Patient {
  id               String         @id @default(uuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id])
  bloodType        String?
  lastVisit        DateTime?
  isPremium        Boolean        @default(false)
  assignedDoctorId String?
  assignedDoctor   Doctor?        @relation("PatientDoctor", fields: [assignedDoctorId], references: [id])
  cases            Case[]         @relation("PatientCases")
  consultations    Consultation[]
}

model Consultation {
  id         String             @id @default(uuid())
  patientId  String
  doctorId   String
  disease    String
  confidence Float              @default(0)
  status     ConsultationStatus @default(PENDING)
  acceptedAt DateTime?
  createdAt  DateTime           @default(now())
  patient    Patient            @relation(fields: [patientId], references: [id])
  doctor     Doctor             @relation(fields: [doctorId], references: [id])
  messages   Message[]
}

model Message {
  id             String       @id @default(uuid())
  consultationId String
  senderId       String
  senderRole     String
  text           String
  createdAt      DateTime     @default(now())
  consultation   Consultation @relation(fields: [consultationId], references: [id])
}

model PasswordHistory {
  id        String   @id @default(uuid())
  userId    String
  password  String
  changedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Case {
  id          String     @id @default(uuid())
  caseNumber  Int        @default(autoincrement())
  patientName String
  doctorName  String
  patientId   String?
  patient     Patient?   @relation("PatientCases", fields: [patientId], references: [id])
  doctorId    String?
  doctor      Doctor?    @relation("DoctorCases", fields: [doctorId], references: [id])
  condition   String
  risk        RiskLevel
  status      CaseStatus @default(PENDING)
  confidence  Float
  date        DateTime   @default(now())
  notes       String?
}

model Report {
  id           String       @id @default(uuid())
  reportNumber Int          @default(autoincrement())
  title        String
  type         ReportType
  doctorName   String
  doctorId     String?
  doctor       Doctor?      @relation("DoctorReports", fields: [doctorId], references: [id])
  status       ReportStatus @default(DRAFT)
  date         DateTime     @default(now())
  casesCount   Int
  findings     String?
}

model Admin {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      AdminRole @default(ADMINISTRATOR)
  avatar    String?
  createdAt DateTime  @default(now())
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AdminRole {
  ADMINISTRATOR
  DERMATOLOGIST
  SKIN_ANALYST
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum CaseStatus {
  PENDING
  DIAGNOSED
  CLOSED
}

enum ReportType {
  MONTHLY
  QUARTERLY
  ANNUAL
  SPECIAL
}

enum ReportStatus {
  DRAFT
  PUBLISHED
}

enum ConsultationStatus {
  PENDING
  OPEN
  CLOSED
}
